# PayPal — get keys from https://developer.paypal.com/dashboard/applications
# Use the same PayPal account as paypal.me/EthanCiuffreda
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# sandbox (testing) or live (real payments — your real PayPal + cards)
PAYPAL_MODE=sandbox
# Go live: Live tab keys below, PAYPAL_MODE=live, same vars on Render, redeploy
PAYPAL_ME_USERNAME=EthanCiuffreda

# Optional Stripe fallback (legacy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Random string for signing download links (generate: openssl rand -hex 32)
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string

# Public URL for emails and PayPal (no trailing slash)
SITE_URL=http://localhost:4242
# Render production: SITE_URL=https://usbgames.onrender.com
# When testing on your PC with npm start, checkout sends localhost automatically.
# Or set: SITE_URL=http://localhost:4242

PORT=4242

# Staff code to unlock the "Answer FAQs" tab on faq.html (set your own secret)
# Copy this file to .env — the server only reads .env, not .env.example
FAQ_ADMIN_CODE=change-me-to-your-secret-code

# Email bot — pick ONE (both can be in .env; EMAIL_PROVIDER chooses which sends):
#
# Option A — Resend (easy test address, ~3000/mo): https://resend.com → API Keys
# onboarding@resend.dev is NOT your inbox — you cannot verify it on Gravatar.
# For inbox avatar with Resend you need your own domain verified in Resend + BIMI/Gravatar.
RESEND_API_KEY=
RESEND_FROM_NAME=UsbGames
RESEND_FROM_EMAIL=onboarding@resend.dev
#
# Option B — Gmail SMTP (recommended if you want inbox profile photo / Gravatar)
# 1. Google Account → Security → 2-Step Verification ON → App passwords → create "UsbGames"
# 2. Set EMAIL_PROVIDER=smtp and fill SMTP_* below (same address as SUPPORT_EMAIL is fine)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=UsbGames <your@gmail.com>
# Inbox circle: https://myaccount.google.com/personal-info → Photo (or gravatar.com with this Gmail)
#
# EMAIL_PROVIDER=auto   → Resend if RESEND_API_KEY set, else Gmail
# EMAIL_PROVIDER=resend → force Resend
# EMAIL_PROVIDER=smtp   → force Gmail (use when both keys are set)

# PayPal webhooks (developer.paypal.com → your app → Webhooks)
# URL: https://YOUR-API-HOST/api/paypal/webhook
# Events: Checkout order approved, Payment capture completed
PAYPAL_WEBHOOK_ID=

# Support email shown if code is missing or redeem fails
SUPPORT_EMAIL=EthanCiuffreda12@gmail.com

# Download counters: edit checkout/download-stats.defaults.json for "before" baselines.
# Live tracked counts live in checkout/data/download-stats.json (created on server).
